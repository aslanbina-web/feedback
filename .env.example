# Public app URL used by LINE redirects and referral links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase server credentials. Never expose the service-role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# LINE Login channel credentials.
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=

# At least 32 random characters, used to sign the HTTP-only session cookie.
SESSION_SECRET=

# Optional. Defaults to requiring Official Account friendship for new users.
SIGNUP_REQUIRES_OA_FRIEND=true
LINE_OFFICIAL_ACCOUNT_URL=https://line.me/R/ti/p/@YOUR_ACCOUNT
